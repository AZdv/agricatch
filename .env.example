# Copy to .env and fill in. Never commit the real file.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Path to the sqlite file. Defaults to BASE_DIR/agricatch.sqlite3 when unset.
# Only sqlite is wired up; point DATABASES at something else in settings.py if
# you need a real server.
DATABASE_NAME=
